{
  "jcr:primaryType": "sling:OrderedFolder",
  "aem-dictionary-translator": {
    "jcr:primaryType": "sling:Folder",
    "content": {
      "jcr:primaryType": "nt:folder",
      "granite": {
        "jcr:primaryType": "nt:folder",
        "field": {
          "jcr:primaryType": "sling:Folder",
          "publish": {
            "jcr:primaryType": "nt:unstructured",
            "action": "aem-dictionary-translator.dictionary.publish",
            "activeCondition": "aem-dictionary-translator.dictionary.editable",
            "icon": "publish",
            "text": "Publish",
            "variant": "actionBar",
            "command": "p",
            "sling:resourceType": "granite/ui/components/coral/foundation/collection/action",
            "granite:rendercondition": {
              "jcr:primaryType": "nt:unstructured",
              "agentId": "publish",
              "sling:resourceType": "aem-dictionary-translator/components/rendercondition/replication-agent-enabled"
            }
          },
          "publish-preview": {
            "jcr:primaryType": "nt:unstructured",
            "action": "aem-dictionary-translator.dictionary.publish",
            "activeCondition": "aem-dictionary-translator.dictionary.editable",
            "icon": "globe",
            "text": "Publish to Preview",
            "variant": "actionBar",
            "sling:resourceType": "granite/ui/components/coral/foundation/collection/action",
            "data": {
              "jcr:primaryType": "nt:unstructured",
              "agentId": "preview"
            },
            "granite:rendercondition": {
              "jcr:primaryType": "nt:unstructured",
              "agentId": "preview",
              "sling:resourceType": "aem-dictionary-translator/components/rendercondition/replication-agent-enabled"
            }
          }
        }
      },
      "dictionaries": {
        "jcr:primaryType": "cq:Page",
        "jcr:content": {
          "views": {
            "jcr:primaryType": "nt:unstructured",
            "list": {
              "jcr:primaryType": "nt:unstructured",
              "src": "/apps/aem-dictionary-translator/content/dictionaries/jcr:content/views/list{.offset,limit}.html${requestPathInfo.suffix}",
              "limit": "20",
              "sling:resourceType": "granite/ui/components/coral/foundation/table",
              "datasource": {
                "jcr:primaryType": "nt:unstructured",
                "offset": "${requestPathInfo.selectors[0]}",
                "itemResourceType": "aem-dictionary-translator/components/dictionary",
                "limit": "${empty requestPathInfo.selectors[1] ? '21' : requestPathInfo.selectors[1] + 1}",
                "sling:resourceType": "aem-dictionary-translator/datasource/dictionary"
              }
            }
          }
        },
        "message-entries": {
          "jcr:primaryType": "cq:Page",
          "jcr:content": {
            "jcr:primaryType": "nt:unstructured",
            "actions": {
              "jcr:primaryType": "nt:unstructured",
              "primary": {
                "jcr:primaryType": "nt:unstructured",
                "create-key": {
                  "jcr:primaryType": "nt:unstructured",
                  "action": "foundation.dialog",
                  "target": "#key-list",
                  "icon": "add",
                  "text": "Create Key",
                  "variant": "primary",
                  "sling:resourceType": "granite/ui/components/coral/foundation/collection/action",
                  "data": {
                    "jcr:primaryType": "nt:unstructured",
                    "src.uritemplate": "/apps/aem-dictionary-translator/content/granite/dialog/dictionary/key/create.html${requestPathInfo.suffix}"
                  },
                  "granite:rendercondition": {
                    "jcr:primaryType": "nt:unstructured",
                    "path": "${requestPathInfo.suffix}",
                    "sling:resourceType": "aem-dictionary-translator/components/rendercondition/editable-dictionary"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "dictionaries": {
    "jcr:primaryType": "sling:Folder",
    "jcr:title": "Dictionaries",
    "fruit": {
      "jcr:primaryType": "sling:Folder",
      "i18n": {
        "jcr:primaryType": "sling:Folder",
        "en": {
          "jcr:primaryType": "sling:Folder",
          "jcr:mixinTypes": [
            "mix:language"
          ],
          "sling:basename": "/content/dictionaries/fruit/i18n",
          "jcr:language": "en",
          "sling:resourceType": "sling:Folder",
          "apple": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Apple",
            "sling:key": "apple"
          },
          "banana": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Banana"
          },
          "cherry": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Cherry",
            "sling:key": "cherry"
          }
        },
        "nl_be": {
          "jcr:primaryType": "nt:folder",
          "jcr:mixinTypes": [
            "mix:language"
          ],
          "sling:basename": "/content/dictionaries/fruit/i18n",
          "jcr:language": "nl_BE",
          "apple": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Appel",
            "sling:key": "apple"
          },
          "banana": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Banaan"
          },
          "cherry": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Kers",
            "sling:key": "cherry"
          }
        }
      }
    },
    "vegetables": {
      "jcr:primaryType": "sling:Folder",
      "i18n": {
        "jcr:primaryType": "nt:unstructured",
        "en": {
          "jcr:primaryType": "sling:Folder",
          "jcr:mixinTypes": [
            "mix:language"
          ],
          "sling:basename": "/content/dictionaries/vegetables/i18n",
          "jcr:language": "en",
          "sling:resourceType": "sling:Folder",
          "brocolli": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Brocolli",
            "sling:key": "brocolli"
          },
          "carrot": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Carrot"
          },
          "tomato": {
            "jcr:primaryType": "sling:MessageEntry",
            "sling:message": "Tomato",
            "sling:key": "tomato"
          }
        }
      }
    }
  }
}
